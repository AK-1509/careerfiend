  },
  "dependencies": {
    "@careerfiend/shared": "*",
    "@electric-sql/pglite": "0.5.8",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.0",
    "pglite-prisma-adapter": "^0.7.2",
    "prisma": "7.10.0"
  }
}
