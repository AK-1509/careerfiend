# Names and explanations only. Copy to .env.local (npm run setup does this) and fill in. Never commit .env.local.

# --- Data ---------------------------------------------------------------------
# Folder for runtime data on this machine (gitignored): embedded databases, local copies of generated files.
PRIVATE_DIR=./private
# Postgres (Neon pooled URL, postgres://…): one schema for accounts plus one per account.
# Blank = embedded Postgres under <PRIVATE_DIR>/data (one computer; one process at a time).
DATABASE_URL=
# Direct (non-pooled) URL for `npm run db:deploy`; Neon calls it DATABASE_URL_UNPOOLED (either name works)
DATABASE_URL_UNPOOLED=
# Where the server encryption key lives: "keychain" (macOS Keychain / Linux Secret Service),
# an absolute file path OUTSIDE the repo (created with mode 600 if missing), or env:APP_ENCRYPTION_KEY (hosted).
# Each account's key is derived from it. Never change it on a deployment with accounts.
APP_ENCRYPTION_KEY_SOURCE=keychain

# --- AI -----------------------------------------------------------------------
# Nothing to set for a public deployment: each person connects their own model (Settings).
# The variables below are used only by tests and scripts that run without an account.
AI_PROVIDER=none

# --- Gmail (optional; self-hosting only) ------------------------------------
# Google Cloud OAuth client. Set only if you want the Email tab (each account connects its own inbox). Access level is chosen in the dashboard:
# label mode (gmail.modify, used only to add labels) or read-only (gmail.readonly). Never a send scope.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
# Minutes between inbox checks (minimum 5)
EMAIL_POLL_MINUTES=30

# --- Public edition -----------------------------------------------------------
# "false" closes sign-ups (existing accounts still sign in)
SIGNUPS_OPEN=true
# "on" (self-hosting only): also fill application forms in a browser, with review + APPROVE + SUBMIT
FORM_FILLING=off
# Largest résumé PDF accepted (MB, at most 4.5 on Vercel)
MAX_UPLOAD_MB=4
# Optional read-only GitHub token (raises the anonymous rate limit for the "GitHub projects" feature)
GITHUB_TOKEN=

# --- Browser worker ---------------------------------------------------------
# Optional; defaults to <PRIVATE_DIR>/browser-profile
PLAYWRIGHT_PROFILE_DIR=
# "false" shows the browser window (needed for takeovers)
BROWSER_HEADLESS=false
BROWSER_CONCURRENCY=1
# Default run window and end-of-day time (both editable on the Daily queue); 00:00-00:00 = always
RUN_WINDOW=00:00-00:00
END_OF_DAY=18:00
# Blank = no limit (also editable on the Daily queue)
DAILY_PREPARE_LIMIT=
# Only for the local fixture site (tests, npm run demo)
ALLOW_LOCALHOST_TARGETS=false

# --- Output (D2) -------------------------------------------------------------
# CareerFiend never decides whether you apply: every link gets documents.
RESUME_PAGE_LIMIT=1

# --- Hosting (set on Vercel; see README "Deploy") ----------------------------
# "hosted" on Vercel only. Requires a Postgres DATABASE_URL.
CAREERFIEND_MODE=local
# Signs sign-in cookies (32+ random bytes, base64). `npm run setup` or `npm run hosted:env` makes one.
SESSION_SECRET=
# Public origin of the deployment, e.g. https://your-app.vercel.app
PUBLIC_URL=
# Time zone for dates in the dashboard, e.g. America/Los_Angeles
DISPLAY_TIMEZONE=
# Longest pause between queue checks while the worker is idle (seconds)
WORKER_MAX_IDLE_SECONDS=60

# --- Housekeeping -----------------------------------------------------------
# Days to keep generated files of rejected/closed/failed applications (0 = keep)
RETENTION_DAYS=0
DASHBOARD_PORT=3100
# LOG_LEVEL=info
# LOG_REDACTION=on
